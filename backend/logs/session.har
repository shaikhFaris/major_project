er:before{content:\"\\f1fb\"}.fa-paint-brush:before{content:\"\\f1fc\"}.fa-birthday-cake:before{content:\"\\f1fd\"}.fa-area-chart:before{content:\"\\f1fe\"}.fa-pie-chart:before{content:\"\\f200\"}.fa-line-chart:before{content:\"\\f201\"}.fa-lastfm:before{content:\"\\f202\"}.fa-lastfm-square:before{content:\"\\f203\"}.fa-toggle-off:before{content:\"\\f204\"}.fa-toggle-on:before{content:\"\\f205\"}.fa-bicycle:before{content:\"\\f206\"}.fa-bus:before{content:\"\\f207\"}.fa-ioxhost:before{content:\"\\f208\"}.fa-angellist:before{content:\"\\f209\"}.fa-cc:before{content:\"\\f20a\"}.fa-shekel:before,.fa-sheqel:before,.fa-ils:before{content:\"\\f20b\"}.fa-meanpath:before{content:\"\\f20c\"}"},"headersSize":475,"bodySize":5063,"redirectURL":"","_transferSize":5538},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":107.463,"receive":16.138},"_frameref":"frame@3b38225b1eb60b7dc5dce25801c473a5","_monotonicTime":1500.418,"_resourceType":"stylesheet","serverIPAddress":"164.100.69.3","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.parivahan.gov.in","issuer":"YE1","validFrom":1790138600,"validTo":1797914599}},{"pageref":"page@18aa3fdbe3d1515de806e197fd953d1b","startedDateTime":"2026-10-03T12:33:28.020Z","time":157.23000000000002,"request":{"method":"GET","url":"https://vahan.parivahan.gov.in/vahan4dashboard/vahan/javax.faces.resource/utils.js;jsessionid=B4100F3167D2AD1E5380509230389030?ln=js","httpVersion":"HTTP/1.1","cookies":[{"name":"JSESSIONID","value":"B4100F3167D2AD1E5380509230389030"},{"name":"SERVERID","value":"vahan_ser_8091"},{"name":"SERVERID_8075","value":"vahan_ser_142_129"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"JSESSIONID=B4100F3167D2AD1E5380509230389030; SERVERID=vahan_ser_8091; SERVERID_8075=vahan_ser_142_129"},{"name":"Host","value":"vahan.parivahan.gov.in"},{"name":"Referer","value":"https://vahan.parivahan.gov.in/vahan4dashboard/"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"153\", \"Not_A Brand\";v=\"8\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[{"name":"ln","value":"js"}],"headersSize":730,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-encoding","value":"gzip"},{"name":"content-security-policy","value":"upgrade-insecure-requests"},{"name":"content-type","value":"text/javascript"},{"name":"date","value":"Sat, 03 Oct 2026 12:33:27 GMT"},{"name":"etag","value":"W/\"11872-1785754200000\""},{"name":"expires","value":"Sat, 10 Oct 2026 12:33:28 GMT"},{"name":"last-modified","value":"Mon, 03 Aug 2026 10:50:00 GMT"},{"name":"strict-transport-security","value":"max-age=63072000; includeSubDomains; preload;"},{"name":"transfer-encoding","value":"chunked"},{"name":"vary","value":"accept-encoding"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-xss-protection","value":"1; mode=block"}],"content":{"size":11872,"mimeType":"text/javascript","compression":9164,"text":"/*\r\n * To change this template, choose Tools | Templates\r\n * and open the template in the editor.\r\n */\r\n\r\nfunction saveconfirm() {\r\n\r\n    var savevar = window.confirm(\"Do You Want To Save Data\");\r\n\r\n    return savevar;\r\n\r\n}\r\n\r\nfunction   Updateconfirm()\r\n\r\n{\r\n\r\n    var savevar = window.confirm(\"Do You Want To Update Data\");\r\n\r\n    return savevar;\r\n}\r\n\r\nfunction  Deleteconfirm()\r\n\r\n{\r\n\r\n    var savevar = window.confirm(\"Do You Want To Delete Data\");\r\n\r\n    return savevar;\r\n}\r\n\r\nfunction  Approvalconfirm()\r\n{\r\n    var savevar = window.confirm(\"Do You Want To Send it for Approval\");\r\n    return savevar;\r\n}\r\n\r\nfunction   verifyapproveconfirm(caption)\r\n\r\n{\r\n\r\n\r\n    var savevar = window.confirm(\"Do You Want To \" + caption + \" Data\");\r\n\r\n    return savevar;\r\n}\r\n\r\nfunction makeCaps(data) {\r\n    var val = data.value;\r\n    data.value = val.toUpperCase();\r\n\r\n}\r\n\r\n//for only characters and space\r\nfunction AlphaOnly(e, strExtraChar)\r\n{\r\n    var key;\r\n    var keychar;\r\n    var strCheckString;\r\n\r\n    strCheckString = \"abcdefghijklmnopqrstuvwxyz\" + strExtraChar;\r\n\r\n    if (window.event)\r\n        key = window.event.keyCode;\r\n    else if (e)\r\n        key = e.which;\r\n    else\r\n        return true;\r\n    keychar = String.fromCharCode(key);\r\n    keychar = keychar.toLowerCase();\r\n\r\n    // control keys\r\n    if ((key == null) || (key == 0) || (key == 8) ||\r\n            (key == 9) || (key == 13) || (key == 27))\r\n        return true;\r\n\r\n    // alphas and numbers\r\n    else if ((strCheckString.toString().indexOf(keychar) > -1))\r\n        return true;\r\n    else\r\n        return false;\r\n}\r\n\r\n//for only Numeric\r\nfunction NumericOnly(e, blnDecimal)\r\n{\r\n\r\n    var key;\r\n    var keychar;\r\n    var strCheckString;\r\n\r\n    strCheckString = \"0123456789\";\r\n\r\n    if (blnDecimal)\r\n        strCheckString = strCheckString + \".\";\r\n    // alert(\"isndndndnitinfff\"+ strCheckString);\r\n\r\n    if (window.event)\r\n        key = window.event.keyCode;\r\n    else if (e)\r\n        key = e.which;\r\n    else\r\n        return true;\r\n    keychar = String.fromCharCode(key);\r\n    keychar = keychar.toLowerCase();\r\n\r\n    // control keys\r\n    if ((key == null) || (key == 0) || (key == 8) ||\r\n            (key == 9) || (key == 13) || (key == 27))\r\n        return true;\r\n\r\n    // numbers only\r\n    else if ((strCheckString.toString().indexOf(keychar) > -1))\r\n        return true;\r\n    else\r\n        return false;\r\n}\r\n\r\n//for AlphaNumericOnly\r\nfunction AlphaNumericOnly(e, strExtraChar)\r\n{\r\n    // alert(\"hiii\");\r\n    var key;\r\n    var keychar;\r\n    var strCheckString;\r\n\r\n    strCheckString = \"abcdefghijklmnopqrstuvwxyz0123456789\" + strExtraChar;\r\n    if (window.event)\r\n        key = window.event.keyCode;\r\n    else if (e)\r\n        key = e.which;\r\n    else\r\n        return true;\r\n    keychar = String.fromCharCode(key);\r\n    keychar = keychar.toLowerCase();\r\n\r\n    // control keys\r\n    if ((key == null) || (key == 0) || (key == 8) ||\r\n            (key == 9) || (key == 13) || (key == 27))\r\n        return true;\r\n\r\n    // alphas and numbers\r\n    else if ((strCheckString.toString().indexOf(keychar) > -1))\r\n        return true;\r\n    else\r\n        return false;\r\n}\r\n/*\r\n * To change this template, choose Tools | Templates\r\n * and open the template in the editor.\r\n */\r\nfunction makeCaps(elementName) {\r\n    //alert(\"--hi--\");\r\n    var element = document.getElementById(elementName);\r\n    var val = element.value;\r\n    val = val.toUpperCase();\r\n    element.value = val;\r\n    return true;\r\n}\r\n\r\nfunction makeItCaps(data)\r\n{\r\n    var val = data.value;\r\n    data.value = val.toUpperCase();\r\n    //alert(data.value);\r\n\r\n\r\n}\r\n\r\n\r\n\r\nfunction formatNubmerPart(noPart) {\r\n    var element = document.getElementById(\"tf_REG_NO2\");\r\n    var fmtPart = element.value;\r\n    var fmtNoPart = fmtPart;\r\n    if (fmtPart != \"\") {\r\n        for (var i = fmtPart.length; i <= noPart - 1; i++) {\r\n            fmtNoPart = \"0\" + fmtNoPart;\r\n        }\r\n    }\r\n    element.value = fmtNoPart;\r\n}\r\n\r\nfunction makeNumberPart1() {\r\n    var vehiclenumber1 = document.getElementById(\"tf_REGN_NO1\");\r\n    var Finaloutput1 = vehiclenumber1.value;\r\n    var len = Finaloutput1.length;\r\n    if (len == 0) {\r\n        alert(\"Series part can not be empty\");\r\n    }\r\n}\r\n\r\nfunction makeNumberPart2() {\r\n    var vehiclenumber2 = document.getElementById(\"tf_REGN_NO2\");\r\n    var Finaloutput2 = vehiclenumber2.value;\r\n    var leng = Finaloutput2.length;\r\n    if (leng == 0) {\r\n        alert(\"Number part can not be empty\");\r\n        document.getElementById(\"tf_REGN_NO1\").focus();\r\n    } else {\r\n        vehiclenumber2.value = leadingZero3(Finaloutput2);\r\n    }\r\n}\r\n\r\nfunction checkEntry() {\r\n    var reg1 = document.getElementById(\"tf_REGN_NO1\").value;\r\n    var reg2 = document.getElementById(\"tf_REGN_NO2\").value;\r\n    var chasino = document.getElementById(\"tf_CHASI_NO\").value;\r\n    if (reg1 == null || reg1 == \"\" || reg2 == null || reg2 == \"\" || chasino == null || chasino == \"\") {\r\n        alert(\"Please Enter Reg. No. && Chassis No. Properly..........!!!!!\");\r\n        return false;\r\n    } else {\r\n        return true;\r\n    }\r\n    return true;\r\n}\r\n\r\nfunction checkIt(evt) {\r\n    evt = (evt) ? evt : window.event\r\n    var charCode = (evt.which) ? evt.which : evt.keyCode\r\n    if ((charCode == 32 || charCode > 46) && (charCode < 48 || charCode > 57)) {\r\n        status = \"This field accepts numbers only.\"\r\n        return false\r\n    }\r\n    status = \"\"\r\n    return true\r\n}\r\n\r\nfunction leadingZero3(x) {\r\n    var len = x.length;\r\n    len = 4 - len;\r\n    for (var i = len; i > 0; i--) {\r\n        x = \"0\" + x;\r\n    }\r\n    return x;\r\n}\r\n\r\n\r\n\r\nfunction validation1() {\r\n\r\n    //  alert(\"ffdghghfdfdf\");\r\n\r\n\r\n\r\n    var Wmi_code = document.getElementById(\"txt_district_code\").value;\r\n    if (Wmi_code.length == 0)\r\n    {\r\n        alert(\"Please Enter The Wmi/Plant Code\");\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n    var Wmi_desc = document.getElementById(\"txt_district_descr\").value;\r\n    if (Wmi_desc.length == 0)\r\n    {\r\n        alert(\"Please Enter The Plant Location Code\");\r\n        return false;\r\n\r\n    }\r\n\r\n    var savevar = window.confirm(\"Do You Want To Continue\");\r\n\r\n    return savevar;\r\n}\r\n\r\nfunction validation2() {\r\n\r\n    //  alert(\"ffdghghfdfdf\");\r\n\r\n\r\n    var Wmi_member = document.getElementById(\"cb_memeber_input\").value;\r\n    if (Wmi_member == -1)\r\n    {\r\n        alert(\"Please Select Member\");\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n    var Wmi_code = document.getElementById(\"txt_maker_code\").value;\r\n    if (Wmi_code.length == 0)\r\n    {\r\n        alert(\"Please Enter Maker Code\");\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n    var Wmi_desc = document.getElementById(\"txt_Maker_descr\").value;\r\n    if (Wmi_desc.length == 0)\r\n    {\r\n        alert(\"Please Enter Maker Description\");\r\n        return false;\r\n\r\n    }\r\n\r\n    var savevar = window.confirm(\"Do You Want To Continue\");\r\n\r\n    return savevar;\r\n}\r\n\r\n\r\nfunction validationCity() {\r\n\r\n    //  alert(\"ffdghghfdfdf\");\r\n\r\n\r\n    var state = document.getElementById(\"cb_State_input\").value;\r\n    if (state == -1)\r\n    {\r\n        alert(\"Please Select State\");\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n    var district = document.getElementById(\"cb_District_input\").value;\r\n    if (district == -1)\r\n    {\r\n        alert(\"Please Select District\");\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n    var code = document.getElementById(\"txt_city_code\").value;\r\n    if (code.length == 0)\r\n    {\r\n        alert(\"Please Enter City Code\");\r\n        return false;\r\n\r\n    }\r\n\r\n    var descr = document.getElementById(\"txt_city_descr\").value;\r\n    if (descr.length == 0)\r\n    {\r\n        alert(\"Please Enter City Description\");\r\n        return false;\r\n\r\n    }\r\n\r\n    var savevar = window.confirm(\"Do You Want To Continue\");\r\n\r\n    return savevar;\r\n}\r\n\r\nfunction validationDistrict() {\r\n\r\n    //  alert(\"ffdghghfdfdf\");\r\n\r\n    var state = document.getElementById(\"cb_State_input\").value;\r\n    if (state == -1)\r\n    {\r\n        alert(\"Please Select State\");\r\n        return false;\r\n    }\r\n\r\n    var code = document.getElementById(\"txt_district_code\").value;\r\n    if (code.length == 0)\r\n    {\r\n        alert(\"Please Enter District Code\");\r\n        return false;\r\n    }\r\n\r\n    var descr = document.getElementById(\"txt_district_descr\").value;\r\n    if (descr.length == 0)\r\n    {\r\n        alert(\"Please Enter District Description\");\r\n        return false;\r\n    }\r\n    var savevar = window.confirm(\"Do You Want To Continue\");\r\n    return savevar;\r\n}\r\n\r\nfunction start() {\r\n\r\n    PF('statusDialog').show();\r\n}\r\n\r\nfunction stop() {\r\n    PF('statusDialog').hide();\r\n}\r\n\r\n\r\nfunction pageRefresh() {\r\n    return true;\r\n}\r\n\r\n\r\nfunction ext()\r\n{\r\n//  alert(\"dsdfdfdsfsdf\");\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    this.marginRight = null\r\n// this = chart widget instance        \r\n    // this.cfg = options  \r\n\r\n//    this.cfg.axes = {\r\n////        x2axis: {pad: 1.5},\r\n////        y2axis: {ticks: [22, 44, 66, 88]},\r\n//    }\r\n//    this.cfg.highlighter =\r\n//            {show: true,\r\n//                showMarker: false,\r\n//               // tooltipAxes: 'xy',\r\n//               // yvalues: 2,\r\n//              tooltipContentEditor: tooltipContentEditor,\r\n//                formatString: '<table class=\"jqplot-highlighter\"> \\\r\n//                <tr><td>date:</td><td>%s</td></tr> \\\r\n//                <tr><td>open:</td><td>%s</td></tr> \\\r\n//                            </table>'\r\n//        \r\n//      \r\n//            }\r\n//\r\n//    function tooltipContentEditor(str, seriesIndex, pointIndex, plot) {\r\n//        // display series_label, x-axis_tick, y-axis value\r\n//        return plot.series[seriesIndex][seriesIndex] + \", \" + plot.data[seriesIndex][pointIndex];\r\n//    }\r\n\r\n    this.cfg.grid = {\r\n        background: 'transparent',\r\n        // drawGridlines:false,\r\n        drawBorder: false,\r\n        shadowDepth: 20,\r\n        shadowAngle: 45,\r\n    };\r\n\r\n//    this.cfg.series = [\r\n//        {color: '#ff4466', lineWidth: 5, label: 'good line', varyBarColor: true},\r\n//        {yaxis: 'y2axis', shadow: false, varyBarColor: true}\r\n//    ]\r\n\r\n\r\n\r\n    // this.cfg.seriesDefaults={rendererOptions:varyBarColor = true};\r\n\r\n//    axes = {\r\n//        xaxis: {renderer: $.jqplot.DateAxisRenderer,\r\n//            tickRenderer: $.jqplot.CanvasAxisTickRenderer,\r\n//            tickOptions: {\r\n//                formatString: \"%b %e\",\r\n//                angle: -30,\r\n//                textColor: '#dddddd'\r\n//            },\r\n//        },\r\n//    };\r\n\r\n}\r\n\r\nfunction ext2()\r\n{\r\n    this.marginRight = null\r\n\r\n    this.cfg.grid = {\r\n        background: 'transparent',\r\n        // drawGridlines:false,\r\n        drawBorder: false,\r\n        shadowDepth: 0,\r\n    };\r\n\r\n}\r\n\r\n\r\nfunction extLegend() {\r\n    \r\n     \r\n       var tickColor = \"#666\";\r\n       var gridlineColor = \"rgba(0,0,0,0.1)\";\r\n\r\n       //copy the config options into a variable\r\n       var options = $.extend(true, {}, this.cfg.config);\r\n\r\n      options = {\r\n          tooltips: {\r\n              \r\n             callbacks: {\r\n\r\n                label: function (tooltipItem, data) {\r\n                   return \" \" + (tooltipItem.yLabel*100).toFixed(1) + \"%\";\r\n                }\r\n             }\r\n          },\r\n          scales: {\r\n             yAxes: [{\r\n                display: true,\r\n                scaleLabel: {\r\n                   display: true,\r\n                   labelString: 'Return',\r\n                   fontColor: tickColor\r\n                },\r\n                ticks: {\r\n                   // add $ to y axis label\r\n                   callback: function (value, index, values) {\r\n                       value = value * 100;\r\n                      return value + \" %\";\r\n                   },\r\n                   fontColor: tickColor\r\n                },\r\n                gridLines: {\r\n                   color: gridlineColor\r\n                }\r\n             }]\r\n          }\r\n       };\r\n\r\n       //merge all options into the main chart options\r\n       $.extend(true, this.cfg.config, options);\r\n    }\r\n\r\n\r\n\r\n\r\n\r\n"},"headersSize":500,"bodySize":2708,"redirectURL":"","_transferSize":3208},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":140.889,"receive":16.341},"_frameref":"frame@3b38225b1eb60b7dc5dce25801c473a5","_monotonicTime":1500.511,"_resourceType":"script","serverIPAddress":"164.100.69.3","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"*.parivahan.gov.in","issuer":"YE1","validFrom":1790138600,"validTo":1797914599}},{"pageref":"page@18aa3fdbe3d1515de806e197fd953d1b","startedDateTime":"2026-10-03T12:33:28.020Z","time":554.833,"request":{"method":"GET","url":"https://vahan.parivahan.gov.in/vahan4dashboard/vahan/javax.faces.resource/logoo.png;jsessionid=B4100F3167D2AD1E5380509230389030?ln=images","httpVersion":"HTTP/1.1","cookies":[{"name":"JSESSIONID","value":"B4100F3167D2AD1E5380509230389030"},{"name":"SERVERID","value":"vahan_ser_8091"},{"name":"SERVERID_8075","value":"vahan_ser_142_129"}],"headers":[{"name":"Accept","value":"image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"JSESSIONID=B4100F3167D2AD1E5380509230389030; SERVERID=vahan_ser_8091; SERVERID_8075=vahan_ser_142_129"},{"name":"Host","value":"vahan.parivahan.gov.in"},{"name":"Referer","v